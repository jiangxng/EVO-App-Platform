{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evo.local/schemas/plugin-package-v0.1.schema.json",
  "title": "EVO Plugin Package Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "packageId",
    "displayName",
    "version",
    "type",
    "features"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "FOUNDATION_RUNTIME",
        "APPLICATION",
        "RUNTIME_EXTENSION",
        "PLATFORM_PROVIDER",
        "EXPERIENCE",
        "AGENT"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appPlatform": {
          "type": "string",
          "minLength": 1
        },
        "eidos": {
          "type": "string",
          "minLength": 1
        },
        "pluginProtocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "trust": {
          "enum": [
            "FIRST_PARTY",
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "isolation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "DECLARATIVE",
            "WORKER",
            "PROCESS",
            "REMOTE"
          ]
        },
        "isolation": {
          "enum": [
            "HOST",
            "WORKER",
            "PROCESS",
            "REMOTE"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "endpoint",
            "hostAccess",
            "auth"
          ],
          "properties": {
            "protocol": {
              "const": "EVO-REMOTE-RUNTIME-v0.1"
            },
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "hostAccess": {
              "const": "NONE"
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scheme",
                "audience"
              ],
              "properties": {
                "scheme": {
                  "const": "HOST_BEARER"
                },
                "audience": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invocationTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 300000
            },
            "memoryMb": {
              "type": "integer",
              "minimum": 16,
              "maximum": 2048
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "DECLARATIVE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "isolation": {
                "const": "HOST"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "WORKER"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "entrypoint"
            ],
            "properties": {
              "isolation": {
                "const": "WORKER"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PROCESS"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "entrypoint"
            ],
            "properties": {
              "isolation": {
                "const": "PROCESS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "REMOTE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "remote"
            ],
            "properties": {
              "isolation": {
                "const": "REMOTE"
              }
            }
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "algorithm",
        "keyId",
        "signature"
      ],
      "properties": {
        "format": {
          "const": "EVO-SIGNATURE-v0.1"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "digest"
          ],
          "properties": {
            "scope": {
              "enum": [
                "PROCESS_ENTRYPOINT",
                "PACKAGE_BUNDLE"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "INTERNAL_CI",
                "SIGSTORE_BUNDLE",
                "OIDC_CI",
                "SLSA_PROVENANCE"
              ]
            },
            "reference": {
              "type": "string"
            },
            "statement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "_type",
                "subject",
                "predicateType",
                "predicate"
              ],
              "properties": {
                "_type": {
                  "const": "https://in-toto.io/Statement/v1"
                },
                "subject": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "digest"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "digest": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "sha256"
                        ],
                        "properties": {
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      }
                    }
                  }
                },
                "predicateType": {
                  "const": "https://slsa.dev/provenance/v1"
                },
                "predicate": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "buildDefinition",
                    "runDetails"
                  ],
                  "properties": {
                    "buildDefinition": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "buildType",
                        "externalParameters"
                      ],
                      "properties": {
                        "buildType": {
                          "type": "string",
                          "minLength": 1
                        },
                        "externalParameters": {
                          "type": "object"
                        }
                      }
                    },
                    "runDetails": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": [
                        "builder"
                      ],
                      "properties": {
                        "builder": {
                          "type": "object",
                          "additionalProperties": true,
                          "required": [
                            "id"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "sigstore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bundle"
              ],
              "properties": {
                "bundle": {
                  "type": "object"
                }
              }
            }
          }
        },
        "signature": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "const": "PACKAGE"
        },
        "quotaBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publish": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subscribe": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./plugin-feature-v0.1.schema.json"
      }
    },
    "secrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "scope"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "SYSTEM",
              "INSTALLATION",
              "ENTERPRISE",
              "COMPANY",
              "WORKSPACE",
              "USER"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "const": "PROCESS"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "integrity"
        ],
        "properties": {
          "integrity": {
            "required": [
              "artifact"
            ],
            "properties": {
              "artifact": {
                "properties": {
                  "scope": {
                    "const": "PROCESS_ENTRYPOINT"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "const": "REMOTE"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "integrity"
        ]
      }
    }
  ]
}
