{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "manager/**/*.ts",
    "contracts/**/*.ts",
    "catalog/**/*.ts",
    "agents/**/*.ts",
    "foundation/**/*.ts",
    "apps/**/*.ts",
    "providers/**/*.ts",
    "vendor/**/*.ts",
    "eog/**/*.ts"
  ]
}
