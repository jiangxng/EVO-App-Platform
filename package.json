{
  "name": "@evo/app-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:all",
    "start": "node dist/manager/server.js",
    "start:agent": "node dist/agents/enterprise-agent/server.js",
    "test:platform": "npm run build && node tools/help-validate.mjs && node tools/eidos-design-language-validate.mjs && node --test tests/protocol/**/*.test.mjs tests/manager/core-manager.test.mjs tests/actions/router.test.mjs tests/integration/app-platform-eidos-plugin-platform.test.mjs",
    "test:all": "npm run build && node --test tests/**/*.test.mjs",
    "test:plugin:enterprise-agent": "npm run build && node --test tests/agent/enterprise-agent.test.mjs tests/app-host/agent-workspace.test.mjs",
    "test:plugin:openai-provider": "npm run build && node --test tests/llm/provider.test.mjs tests/agent/openai-responses-model.test.mjs",
    "test:plugin:ledger-configurator": "npm run build && node --test tests/configurator/configurator.test.mjs tests/ledger-runtime-configurator-compiler.test.mjs tests/ledger-runtime-configurator-ui.test.mjs",
    "test:plugin:trading-lite": "npm run build && node --test tests/actions/trading-lite-evo.test.mjs",
    "test:integration:eidos": "npm run build && node --test tests/integration/app-platform-eidos-plugin-platform.test.mjs",
    "plugin:validate": "npm run build --silent && node tools/plugin-manifest-validate.mjs",
    "test:plugin:host-authorization-provider": "npm run build && node --test tests/protocol/authorization-provider.test.mjs tests/protocol/provider-governance.test.mjs",
    "help:validate": "npm run build --silent && node tools/help-validate.mjs",
    "design:validate": "npm run build --silent && node tools/eidos-design-language-validate.mjs",
    "test:plugin:host-secrets-provider": "npm run build && node --test tests/protocol/secrets-provider.test.mjs tests/settings/plugin-settings.test.mjs",
    "test:plugin:host-enterprise-context-provider": "npm run build && node --test tests/protocol/enterprise-context-provider.test.mjs tests/protocol/person-first-context.test.mjs",
    "test:plugin:host-static-session-provider": "npm run build && node --test tests/protocol/principal-grants.test.mjs tests/protocol/person-first-context.test.mjs",
    "test:plugin:host-enterprise-context-grant-provider": "npm run build && node --test tests/protocol/principal-grants.test.mjs tests/protocol/person-first-context.test.mjs",
    "test:plugin:host-bearer-session-provider": "npm run build && node --test tests/protocol/enterprise-context-creation.test.mjs tests/protocol/person-first-context.test.mjs",
    "test:plugin:host-enterprise-relationship-provider": "npm run build && node --test tests/protocol/enterprise-context-creation.test.mjs tests/protocol/enterprise-relationship-lifecycle.test.mjs tests/protocol/principal-grants.test.mjs",
    "test:plugin:host-context-memory-provider": "npm run build && node --test tests/protocol/context-memory-governance.test.mjs tests/protocol/person-first-context.test.mjs",
    "test:plugin:personal-agent-memory-review": "npm run build && node --test tests/protocol/context-memory-proposal-review.test.mjs tests/protocol/context-memory-governance.test.mjs tests/agent/enterprise-agent.test.mjs",
    "test:plugin:host-memory-intake-provider": "npm run build && node --test tests/protocol/context-memory-intake.test.mjs tests/protocol/context-memory-proposal-review.test.mjs tests/protocol/context-memory-governance.test.mjs",
    "test:plugin:context-memory-p1-2": "npm run build && node --test tests/protocol/context-memory-retention-semantic-ec.test.mjs tests/protocol/context-memory-intake.test.mjs tests/protocol/context-memory-proposal-review.test.mjs tests/protocol/context-memory-governance.test.mjs",
    "test:plugin:context-memory-p1-3": "npm run build && node --test tests/protocol/context-memory-p1-3-operations.test.mjs tests/protocol/context-memory-retention-semantic-ec.test.mjs tests/protocol/context-memory-intake.test.mjs tests/protocol/context-memory-proposal-review.test.mjs tests/protocol/context-memory-governance.test.mjs",
    "test:experience:p1-3-1": "npm run build && node --test tests/integration/personal-agent-experience-journey.test.mjs tests/app-host/agent-workspace.test.mjs tests/settings/plugin-settings.test.mjs tests/protocol/context-memory-p1-3-operations.test.mjs",
    "test:agent:responsibility-p1-4": "npm run build && node --test tests/agent/enterprise-agent.test.mjs",
    "test:agent-memory:quality-p1-4": "npm run build && node --test tests/protocol/personal-agent-quality-retention-simulation-p1-4.test.mjs tests/agent/enterprise-agent.test.mjs tests/protocol/context-memory-p1-3-operations.test.mjs",
    "test:agent-memory:quality-p1-4c": "npm run build && node --test tests/protocol/personal-agent-quality-retention-flow-p1-4c.test.mjs tests/protocol/personal-agent-quality-retention-simulation-p1-4.test.mjs tests/agent/enterprise-agent.test.mjs tests/protocol/context-memory-p1-3-operations.test.mjs",
    "test:agent-memory:quality-p1-4d": "npm run build && node --test tests/protocol/personal-agent-human-eval-memory-quality-p1-4d.test.mjs tests/protocol/personal-agent-quality-retention-flow-p1-4c.test.mjs tests/protocol/personal-agent-quality-retention-simulation-p1-4.test.mjs tests/agent/enterprise-agent.test.mjs tests/protocol/context-memory-p1-3-operations.test.mjs",
    "test:agent-memory:quality-p1-4e": "npm run build && node --test tests/protocol/personal-agent-trends-freshness-followup-p1-4e.test.mjs tests/protocol/personal-agent-human-eval-memory-quality-p1-4d.test.mjs tests/protocol/personal-agent-quality-retention-flow-p1-4c.test.mjs tests/agent/enterprise-agent.test.mjs tests/protocol/context-memory-p1-3-operations.test.mjs",
    "experience:start": "npm run build && node tools/start-personal-agent-experience.mjs",
    "experience:reset": "npm run build --silent && node tools/reset-personal-agent-experience.mjs",
    "test:experience:p1-4-checkpoint": "npm run build && node --test tests/app-host/dynamic-chat-actions.test.mjs tests/integration/personal-agent-vertical-experience-checkpoint.test.mjs tests/integration/personal-agent-experience-journey.test.mjs tests/protocol/personal-agent-trends-freshness-followup-p1-4e.test.mjs",
    "test:plugin:deepseek-provider": "npm run build && node --test tests/llm/deepseek-provider.test.mjs tests/llm/provider.test.mjs tests/integration/personal-agent-experience-journey.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "sigstore": "5.0.0"
  }
}
